# Local development defaults to SQLite. For PostgreSQL, use the example below.
DATABASE_URL=sqlite:///./snwebshield_dev.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_NAME=SNWebShield API
APP_VERSION=0.1.0

# Replace locally with a random secret of at least 32 bytes. Never commit it.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=20
JWT_ISSUER=snwebshield-api
JWT_AUDIENCE=snwebshield-admin

# PostgreSQL example (create the database and user before using it):
# DATABASE_URL=postgresql+psycopg://snwebshield_user:CHANGE_ME@localhost:5432/snwebshield

# Private storage defaults to the current user home, outside this repository.
# EVIDENCE_ROOT=C:/Users/YOUR_USER/SNWebShield-Private/evidence
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_RETENTION_DAYS=365
