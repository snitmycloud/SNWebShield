# Local development defaults to SQLite. For PostgreSQL, use the example below.
DATABASE_URL=sqlite:///./snwebshield_dev.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_NAME=SNWebShield API
APP_VERSION=0.1.0

# Replace locally with a random secret of at least 32 bytes. Never commit it.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=20
JWT_ISSUER=snwebshield-api
JWT_AUDIENCE=snwebshield-admin

# PostgreSQL example (create the database and user before using it):
# DATABASE_URL=postgresql+psycopg://snwebshield_user:CHANGE_ME@localhost:5432/snwebshield

# Private storage defaults to the current user home, outside this repository.
# EVIDENCE_ROOT=C:/Users/YOUR_USER/SNWebShield-Private/evidence
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_RETENTION_DAYS=365

# Monitoring notifications default to the internal dashboard. SMTP uses TLS port 465.
NOTIFICATION_CHANNEL=dashboard
# NOTIFICATION_RECIPIENT=ops@example.com
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SENDER=monitor@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Explicitly enable the fixed local single-HEAD profile after local review.
ASSESSMENT_LOCAL_HTTP_ENABLED=false

# Existing Azure VM only. Requires OS SSH agent/config and a manually installed runner.
# Leave the local profile disabled when using remote Docker analysis.
ASSESSMENT_REMOTE_DOCKER_ENABLED=false
ASSESSMENT_REMOTE_IMAGE_ID=

# Requires separate tcp_port_discovery permission and the installed firewall/Nmap runner.
ASSESSMENT_NMAP_ENABLED=false
ASSESSMENT_NMAP_IMAGE_ID=
