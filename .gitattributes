# Linux runner shebangs and Docker assets must keep Unix line endings on Windows.
scanner/** text eol=lf

# Vendored Nuclei templates are hashed byte for byte (MANIFEST.json): never convert line endings.
backend/app/data/nuclei/templates/** -text

# Linux files must keep LF line endings (a CRLF in a systemd unit breaks it)
deploy/** text eol=lf
*.service text eol=lf
